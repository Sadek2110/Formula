---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  tone?: 'dark' | 'paper';
  align?: 'start' | 'center';
  titleId?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  text,
  tone = 'dark',
  align = 'start',
  titleId,
  class: className,
} = Astro.props;
---
<div class:list={['section-header', align === 'center' && 'section-header--center', className]}>
  <Eyebrow tone={tone}>{eyebrow}</Eyebrow>
  <h2 class="h2" id={titleId}>{title}</h2>
  {text && <p class:list={['lead', 'section-header-text', tone === 'paper' ? 'muted-paper' : 'muted']}>{text}</p>}
</div>
