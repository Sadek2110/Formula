---
import { Picture } from 'astro:assets';
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import heroDesktop from '../../assets/formula/hero-formula-desktop.jpg';
import heroMobile from '../../assets/formula/hero-formula-mobile.jpg';

const { hero } = site;
---
<section class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal>{hero.eyebrow}</p>
      <h1 class="display" data-reveal="1">{hero.title}</h1>
      <p class="lead muted hero-text" data-reveal="2">{hero.text}</p>
      <div class="hero-ctas" data-reveal="2">
        <Button href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</Button>
        <Button href={hero.ctaSecondary.href} variant="secondary">{hero.ctaSecondary.label}</Button>
      </div>
    </div>
    <div class="hero-visual-mobile" data-reveal-hero>
      <Picture
        src={heroMobile}
        alt={hero.imageAltMobile}
        widths={[480, 640, 800]}
        sizes="(min-width: 480px) 480px, 85vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <p class="hero-micro mono" data-reveal="3">{hero.microcopy}</p>
  </div>
  <div class="hero-visual-desktop" data-hero-visual data-reveal-hero>
    <Picture
      src={heroDesktop}
      alt={hero.imageAltDesktop}
      widths={[640, 820, 1024, 1280]}
      sizes="55vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<script>
  const visual = document.querySelector('[data-hero-visual]');

  if (visual) {
    const fine = window.matchMedia('(pointer: fine)');
    const wide = window.matchMedia('(min-width: 1024px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const eligible = () => fine.matches && wide.matches && !reduced.matches;

    let raf = 0;
    let targetX = 0;
    let targetY = 0;
    let targetR = 0;
    let currentX = 0;
    let currentY = 0;
    let currentR = 0;

    const tick = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      currentR += (targetR - currentR) * 0.08;
      visual.style.rotate = `${currentR.toFixed(3)}deg`;
      visual.style.translate = `${currentX.toFixed(2)}px ${currentY.toFixed(2)}px`;
      if (
        Math.abs(targetX - currentX) +
          Math.abs(targetY - currentY) +
          Math.abs(targetR - currentR) >
        0.05
      ) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
      }
    };

    const queue = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    const onMove = (event: PointerEvent) => {
      if (!eligible()) return;
      const nx = event.clientX / window.innerWidth - 0.5;
      const ny = event.clientY / window.innerHeight - 0.5;
      targetX = nx * 22;
      targetY = ny * 16;
      targetR = nx * 10;
      queue();
    };

    const onLeave = () => {
      targetX = 0;
      targetY = 0;
      targetR = 0;
      queue();
    };

    window.addEventListener('pointermove', onMove, { passive: true });
    document.documentElement.addEventListener('mouseleave', onLeave);
  }
</script>
