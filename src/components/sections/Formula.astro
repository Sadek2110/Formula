---
import { Picture } from 'astro:assets';
import { formula, formulaSteps } from '../../data/formula';
import SectionHeader from '../ui/SectionHeader.astro';
import Tag from '../ui/Tag.astro';
import sevenLayers from '../../assets/formula/formula-seven-layers.jpg';
---
<section class="section" id="metodo" aria-labelledby="metodo-title">
  <div class="wrap">
    <SectionHeader
      eyebrow={formula.eyebrow}
      title={formula.title}
      text={formula.text}
      titleId="metodo-title"
    />
    <div class="formula-grid">
      <ol class="steps">
        <div class="steps-progress" data-steps-progress aria-hidden="true"></div>
        {
          formulaSteps.map((step, index) => (
            <li class="step" data-step data-step-index={index}>
              <span class="step-n" aria-hidden="true">
                {step.n}
              </span>
              <div class="step-body">
                <h3 class="step-title">{step.title}</h3>
                <p class="step-subtitle">{step.subtitle}</p>
                <p class="step-text">{step.text}</p>
                <Tag>{step.tag}</Tag>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="formula-visual">
        <div class="formula-visual-sticky" data-formula-visual data-reveal-hero>
          <div data-formula-static>
            <Picture
              src={sevenLayers}
              alt={formula.imageAlt}
              widths={[480, 640, 820, 1024]}
              sizes="(min-width: 1024px) 40vw, 90vw"
              formats={['avif', 'webp']}
              loading="lazy"
            />
          </div>
          <video
            class="formula-video"
            data-formula-video
            muted
            playsinline
            preload="none"
            aria-hidden="true"
          ></video>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
  const progress = document.querySelector<HTMLElement>('[data-steps-progress]');

  if (steps.length > 0) {
    const setActive = (index: number) => {
      steps.forEach((step, i) => {
        step.classList.toggle('is-active', i === index);
        if (i === index) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
      });
      if (progress) progress.style.blockSize = `${((index + 0.5) / steps.length) * 100}%`;
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const index = steps.indexOf(entry.target as HTMLElement);
            if (index !== -1) setActive(index);
          }
        },
        { rootMargin: '-35% 0px -35% 0px', threshold: 0 },
      );
      steps.forEach((step) => observer.observe(step));
    }
  }

  /* Vídeo de scroll ligado al progreso de la sección.
     Solo desktop (≥1024px) y sin prefers-reduced-motion:
     en cualquier otro caso no se cargan las fuentes y
     permanece la imagen estática. */
  const visual = document.querySelector('[data-formula-visual]');
  const videoEl = document.querySelector<HTMLVideoElement>('[data-formula-video]');
  const staticEl = document.querySelector('[data-formula-static]');

  if (visual && videoEl && staticEl) {
    const section = visual.closest('section');
    const wide = window.matchMedia('(min-width: 1024px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const eligible = () => wide.matches && !reduced.matches;

    let active = false;
    let duration = 0;
    let raf = 0;

    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        if (!section || !duration) return;
        const rect = section.getBoundingClientRect();
        const viewport = window.innerHeight;
        const progress = Math.min(
          1,
          Math.max(0, (viewport - rect.top) / (rect.height + viewport)),
        );
        videoEl.currentTime = progress * duration;
      });
    };

    const activate = () => {
      if (active) return;
      active = true;
      videoEl.poster = '/assets/formula/formula-scroll-poster.jpg';
      if (!videoEl.querySelector('source')) {
        const mp4 = document.createElement('source');
        mp4.src = '/assets/formula/formula-scroll.mp4';
        mp4.type = 'video/mp4';
        const webm = document.createElement('source');
        webm.src = '/assets/formula/formula-scroll.webm';
        webm.type = 'video/webm';
        videoEl.append(mp4, webm);
      }
      videoEl.load();
      videoEl.addEventListener(
        'loadedmetadata',
        () => {
          duration = videoEl.duration || 0;
          videoEl.classList.add('is-active');
          staticEl.classList.add('is-hidden');
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        },
        { once: true },
      );
    };

    const deactivate = () => {
      if (!active) return;
      active = false;
      window.removeEventListener('scroll', onScroll);
      videoEl.pause();
      videoEl.classList.remove('is-active');
      staticEl.classList.remove('is-hidden');
    };

    if (eligible()) activate();

    wide.addEventListener('change', () => {
      if (eligible()) activate();
      else deactivate();
    });
    reduced.addEventListener('change', () => {
      if (eligible()) activate();
      else deactivate();
    });
  }
</script>
